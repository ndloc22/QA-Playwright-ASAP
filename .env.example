# Base URL of ASAP application under test (used by playwright.config.ts + scripts).
# Example: https://bolt.server.ivy-cloud.com/ivy_12_kf/EON_LDAP/asap
BASE_URL=https://your-asap-test-server.example.com/asap

# Credentials for the login flow (optional — only if your app requires auth).
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# (Tuy chon) Thoi gian toi da (ms) CHO Tester dang nhap SSO/MFA thu cong khi chay
# 
pm run test:function. Mac dinh 120000 (120s). Tang neu MFA tren dien thoai cham.
SSO_TIMEOUT=120000

# (Tùy chọn) Kích thước viewport khi record. Mặc định để trống hoặc 'auto' = Tự động nhận diện full màn hình thật của máy (khuyến nghị, hỗ trợ 2K 2560x1440, Full HD 1920x1080...).
# Các tùy chọn cố định khác nếu muốn: 2560,1440 (2K) | 1920,1080 (Full HD) | 1600,900 (Desktop vừa) | 1366,768 (Laptop)
CODEGEN_VIEWPORT=

# -------------------------------------------------------------
# 🤖 CẤU HÌNH AI AGENT (Mode 2: npm run test:agent)
# -------------------------------------------------------------
# Chọn AI CLI mặc định: claude | copilot
AI_AGENT_CLI=claude

# Tự động fallback sang CLI còn lại nếu CLI chính hết quota/token
AI_AGENT_FALLBACK=true

# Model chỉ định cho GitHub Copilot CLI (mặc định claude-opus-4.8)
COPILOT_MODEL=claude-opus-4.8

# Timeout tối đa cho mỗi lượt AI phân tích DOM (ms)
AI_AGENT_TIMEOUT=60000